# Voice Input Bench — environment variables
#
# Every variable here is optional. Production reads all of them through
# src/lib/engineConfig.ts and falls back to the defaults shown below, so the app
# runs with no .env file at all. A value is trimmed before use and an empty
# value counts as unset. The two timeout variables are accepted only if they
# parse as a finite number greater than 0; anything else falls back to default.
#
#   cp .env.example .env
#
# Everything below is commented out on purpose: copying this file as-is changes
# no behaviour.

# ── AivisSpeech (local TTS) ─────────────────────────────────────────────────

# Base URL of the AivisSpeech Engine. The default engine port is 10101.
# Default: http://127.0.0.1:10101
# AIVIS_ENGINE_URL=http://127.0.0.1:10101

# Request timeout in milliseconds for AivisSpeech Engine calls.
# Default: 30000
# AIVIS_ENGINE_TIMEOUT_MS=30000

# ── Storage roots (the four immutable artifact roots) ───────────────────────
#
# Each root must be a directory of its own: no root may be the same as, or live
# inside, another. A violation is refused before anything is written
# (ROOT_ISOLATION_VIOLATED, HTTP 500). There is deliberately no reports root —
# a Report package is an operator export, not a fifth stored artifact.
#
# Defaults are resolved against the process working directory:
#   <cwd>/data/runs
#   <cwd>/data/results
#   <cwd>/data/sessions
#   <cwd>/data/evaluations

# VIB_RUNS_DIR=./data/runs
# VIB_RESULTS_DIR=./data/results
# VIB_SESSIONS_DIR=./data/sessions
# VIB_EVALUATIONS_DIR=./data/evaluations

# ── Semantic evaluator runtime (semantic-h3-v1 only) ────────────────────────
#
# Needed only when running the semantic-h3-v1 evaluator. Generating audio,
# saving Results, the other three evaluators, Run Comparison and Report Export
# all work without a semantic runtime.

# Ollama endpoint. Loopback only: the host must be written literally as
# 127.0.0.1, localhost, ::1 or [::1]. A non-loopback host, a numeric form such
# as 127.1 or 2130706433, credentials in the URL, or a redirect is refused
# (SEMANTIC_ENDPOINT_NOT_LOOPBACK). Only /api/version, /api/tags, /api/show and
# /api/chat are ever requested.
# Default: http://127.0.0.1:11434
# VIB_SEMANTIC_ENDPOINT=http://127.0.0.1:11434

# Timeout in milliseconds for semantic runtime calls. One variable covers both
# calls: the /api/chat request (default 300000) and the preflight probe
# (default 10000). Setting it overrides both.
# Default: 300000 for chat, 10000 for preflight
# VIB_SEMANTIC_TIMEOUT_MS=300000
