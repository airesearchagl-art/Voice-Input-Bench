# AivisSpeech Engine base URL.
# Start AivisSpeech (or AivisSpeech Engine) locally before using the app.
# Default engine port is 10101.
AIVIS_ENGINE_URL=http://127.0.0.1:10101

# Request timeout in milliseconds for AivisSpeech Engine calls.
# Optional. Defaults to 30000.
# AIVIS_ENGINE_TIMEOUT_MS=30000
